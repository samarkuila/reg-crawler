# Copy to .env — never commit .env
REPO_BACKEND=memory            # memory | sql  (sql: run migrate, then seed-demo for demo data)
DATABASE_URL=sqlite:///data/reg_monitor.db
POC_USER_SWITCHER=true
APP_ENV=dev                    # dev | prod  (the POC user switcher is hidden when prod)

# Luna NBFC Screening Agent (optional; system must work with it off)
AGENT_LUNA_ENABLED=false
LLM_PROVIDER=                  # azure_openai | openai
LLM_MODEL=gpt-6-luna
LLM_ENDPOINT=
LLM_DEPLOYMENT=
LLM_API_VERSION=
LLM_API_KEY=

# Where snapshot/document files are stored (paths in the database are relative to this)
FILES_ROOT=.

# "Test this source" on the Sources page: live = run the real spider as a dry run (one page, nothing saved);
# mock = made-up demo rows. Default: live with REPO_BACKEND=sql, mock with memory.
# SOURCE_TESTER=live

# Crawler (Scrapy subprocess; the contact address for the User-Agent is crawler.contact in config/settings.yaml)
# A crawl defaults to REPO_BACKEND=sql, and to the database and files under the repository root.
REGCRAWLER_PROFILE=prod        # prod | dev  (dev turns on the HTTP cache; never use it for real runs)
# REGCRAWLER_PLAYWRIGHT=1      # only for sources with requires_js; needs: pip install -e .[js] and playwright install chromium
# REGCRAWLER_SETTINGS_FILE=    # optional: another settings.yaml (block markers, contact)
